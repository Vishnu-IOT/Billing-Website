+              autoFocus
+              inputMode="decimal"
+              placeholder="0.00"
+              aria-invalid={touched && floatMissing}
+              value={floatValue}
+              onChange={(e) => {
+                const v = e.target.value;
+                if (v === "" || /^\d{0,7}(\.\d{0,2})?$/.test(v)) onFloatChange(v);
+              }}
+              onFocus={(e) => e.target.select()}
+            />
+          </div>
+          {touched && floatMissing && (
+            <div className="bf-error" role="alert">
+              Enter the opening float (enter 0 if the drawer starts empty).
+            </div>
+          )}
+
+          <div className="bf-presets-head">
+            <span className="bf-label">FLOAT PRESET SHORTCUTS</span>
+            <button type="button" className="bf-link" onClick={() => onFloatChange("0")}>
+              RESET TO ZERO
+            </button>
+          </div>
+          <div className="bf-presets">
+            {PRESETS.map((p) => (
+              <button
+                key={p}
+                type="button"
+                className="bf-preset"
+                onClick={() => onFloatChange(String(p))}
+              >
+                ₹{money(p).replace(".00", "")}
+              </button>
+            ))}
+          </div>
+        </section>
+
+        <section className="bf-section bf-section--panel">
+          <div className="bf-panelhead">
+            <span className="bf-label">
+              PHYSICAL COUNT BREAKDOWN <span className="bf-tag bf-tag--dark">AUDIT</span>
+            </span>
+            <span
+              className={`bf-status ${
+                !hasCount ? "" : matched ? "is-ok" : "is-bad"
+              }`}
+            >
+              COUNTED: {rupees(counted)}
+              {hasCount && !floatMissing &&
+                (matched ? (
+                  <>
+                    {" "}
+                    <FiCheckCircle /> MATCHED
+                  </>
+                ) : (
+                  <>
+                    {" "}
+                    <FiAlertTriangle /> MISMATCH
+                  </>
+                ))}
+            </span>
+          </div>
+          <DenominationGrid
+            idPrefix="open-den"
+            counts={counts}
+            onCountChange={(d, v) => setCounts((c) => ({ ...c, [d]: v }))}

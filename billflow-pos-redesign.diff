+/* ===== BILLFLOW POS — TERMINAL DESIGN SYSTEM =====
+ * Scoped under .bf-pos / .bf-overlay so nothing leaks into the rest of the app.
+ * Palette + type follow the BillFlow design-system reference.
+ */
+.bf-pos,
+.bf-overlay {
+  --bf-primary: #0f172a;
+  --bf-secondary: #1e40af;
+  --bf-tertiary: #059669;
+  --bf-neutral: #64748b;
+  --bf-bg: #f1f5f9;
+  --bf-surface: #ffffff;
+  --bf-border: #e2e8f0;
+  --bf-success: #059669;
+  --bf-danger: #dc2626;
+  --bf-amber: #b45309;
+  --bf-blue-tint: #dbeafe;
+  --bf-blue-wash: #eff6ff;
+  --bf-green-tint: #d1fae5;
+  --bf-red-tint: #fee2e2;
+  --bf-amber-tint: #fef3c7;
+  --bf-head: "Chivo", "Inter", system-ui, sans-serif;
+  --bf-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  --bf-h: 34px; /* shared control height */
+  font-family: var(--bf-mono);
+  font-size: 12px;
+  color: var(--bf-primary);
+  box-sizing: border-box;
+}
+.bf-pos *,
+.bf-pos *::before,
+.bf-pos *::after,
+.bf-overlay *,
+.bf-overlay *::before,
+.bf-overlay *::after {
+  box-sizing: border-box;
+}
+.bf-pos button,
+.bf-pos input,
+.bf-pos select,
+.bf-overlay button,
+.bf-overlay input {
+  font-family: var(--bf-mono);
+}
+
+/* ───────── Shared atoms ───────── */
+.bf-label {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  font-size: 10px;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  color: var(--bf-neutral);
+  text-transform: uppercase;
+}
+.bf-label--lg { font-size: 11px; color: var(--bf-primary); font-weight: 700; }
+.bf-label--blue { color: var(--bf-secondary); }
+.bf-req { color: var(--bf-danger); }
+.bf-hint { font-size: 11px; color: var(--bf-neutral); margin-top: 2px; }
+.bf-spacer { flex: 1; }
+.bf-tag {
+  display: inline-block;
+  background: var(--bf-primary);
+  color: #fff;
+  padding: 1px 6px;
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: 0.05em;
+}
+.bf-tag--dark { background: #000; }
+.bf-tag--soft { background: var(--bf-blue-tint); color: var(--bf-secondary); }
+.bf-tag--light { background: #fff; color: var(--bf-danger); }
+.bf-kbd {
+  display: inline-block;
+  padding: 0 5px;
+  margin-left: 6px;
+  font-size: 10px;
+  font-weight: 700;
+  line-height: 16px;
+  background: rgba(15, 23, 42, 0.1);
+  border: 1px solid rgba(15, 23, 42, 0.12);
+}
+.bf-btn--blue .bf-kbd,
+.bf-btn--green .bf-kbd,
+.bf-btn--red .bf-kbd {
+  background: rgba(0, 0, 0, 0.28);
+  border-color: rgba(255, 255, 255, 0.25);
+  color: #fff;
+}
+.bf-link {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  background: none;
+  border: 0;
+  padding: 2px 0;
+  cursor: pointer;
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  color: var(--bf-secondary);
+}
+.bf-link:hover { text-decoration: underline; }
+.bf-error { color: var(--bf-danger); font-size: 11px; font-weight: 600; margin-top: 4px; }
+
+.bf-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  height: var(--bf-h);
+  padding: 0 14px;
+  border: 1px solid var(--bf-border);
+  background: var(--bf-surface);
+  color: var(--bf-primary);
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  cursor: pointer;
+  border-radius: 2px;
+  transition: filter 0.12s, background 0.12s;
+}
+.bf-btn:hover:not(:disabled) { filter: brightness(0.96); }
+.bf-btn:disabled { opacity: 0.55; cursor: not-allowed; }
+.bf-btn:focus-visible,
+.bf-method:focus-visible,
+.bf-quick button:focus-visible,
+.bf-preset:focus-visible { outline: 2px solid var(--bf-secondary); outline-offset: 1px; }
+.bf-btn--lg { height: 46px; padding: 0 22px; font-size: 12px; }
+.bf-btn--blue { background: var(--bf-secondary); border-color: var(--bf-secondary); color: #fff; }
+.bf-btn--green { background: var(--bf-tertiary); border-color: var(--bf-tertiary); color: #fff; }
+.bf-btn--red { background: var(--bf-danger); border-color: var(--bf-danger); color: #fff; }
+.bf-btn--ghost { background: var(--bf-surface); }
+
+/* ───────── Modal frame ───────── */
+.bf-overlay {
+  position: fixed;
+  inset: 0;
+  z-index: 9999;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 12px;
+  background: rgba(15, 23, 42, 0.62);
+}
+.bf-modal {
+  --bf-head-bg: var(--bf-primary);
+  width: min(var(--bf-modal-w, 760px), 100%);
+  max-height: calc(100vh - 24px);
+  display: flex;
+  flex-direction: column;
+  background: var(--bf-bg);
+  border: 1px solid #000;
+  box-shadow: 0 12px 32px rgba(15, 23, 42, 0.35);
+  overflow: hidden;
+}
+.bf-modal--green { --bf-head-bg: var(--bf-tertiary); }
+.bf-modal--red { --bf-head-bg: #991b1b; }
+.bf-modal--blue { --bf-head-bg: linear-gradient(90deg, var(--bf-primary), var(--bf-secondary)); }
+.bf-modal__header {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  min-height: 84px;
+  padding: 12px 18px;
+  background: var(--bf-head-bg);
+  color: #fff;
+  flex-shrink: 0;
+}
+.bf-modal--red .bf-modal__header { background: linear-gradient(90deg, #7f1d1d, var(--bf-danger)); }
+.bf-modal__headtext { flex: 1; min-width: 0; }
+.bf-modal__headright { display: flex; align-items: center; gap: 10px; }
+.bf-modal__eyebrow { display: flex; gap: 8px; align-items: center; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.95; }
+.bf-modal__eyebrow .bf-tag { background: rgba(0, 0, 0, 0.35); }
+.bf-modal__title { margin: 4px 0 0; font-family: var(--bf-head); font-weight: 900; font-size: 26px; letter-spacing: 0.01em; line-height: 1.1; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
+.bf-modal__title--sm { font-size: 18px; margin-top: 0; }
+.bf-modal__meta { margin-top: 4px; font-size: 10px; letter-spacing: 0.05em; opacity: 0.85; text-transform: uppercase; }
+.bf-modal__logo { width: 44px; height: 44px; background: #fff; color: var(--bf-primary); display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; }
+.bf-modal__amount { text-align: right; }
+.bf-modal__amount span { display: block; font-size: 10px; letter-spacing: 0.08em; opacity: 0.85; }
+.bf-modal__amount strong { font-family: var(--bf-head); font-size: 34px; font-weight: 900; line-height: 1.05; }
+.bf-modal__close {
+  width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;
+  background: rgba(0, 0, 0, 0.35); border: 0; color: #fff; font-size: 18px; cursor: pointer; flex-shrink: 0;
+}
+.bf-modal__close:hover:not(:disabled) { background: rgba(0, 0, 0, 0.55); }
+.bf-chip { background: rgba(0, 0, 0, 0.28); padding: 6px 10px; font-size: 11px; white-space: nowrap; }
+.bf-modal__body { flex: 1; min-height: 0; overflow-y: auto; padding: 12px 16px; display: flex; flex-direction: column; gap: 10px; }
+.bf-modal__footer {
+  display: flex; align-items: center; gap: 10px; padding: 10px 16px;
+  background: var(--bf-blue-wash); border-top: 1px solid var(--bf-border); flex-shrink: 0;
+}
+.bf-footnote { font-size: 10px; letter-spacing: 0.04em; color: var(--bf-neutral); text-align: right; text-transform: uppercase; }
+
+/* ───────── Blocks ───────── */
+.bf-infobar { display: flex; gap: 28px; padding: 8px 12px; background: var(--bf-surface); border: 1px solid var(--bf-border); }
+.bf-infobar > div { display: flex; flex-direction: column; gap: 2px; }
+.bf-infobar__k { font-size: 9px; letter-spacing: 0.08em; color: var(--bf-neutral); }
+.bf-infobar em { font-style: normal; color: var(--bf-neutral); }
+.bf-section { display: flex; flex-direction: column; gap: 8px; }
+.bf-section--panel { background: var(--bf-surface); border: 1px solid var(--bf-border); padding: 10px 12px; }
+.bf-panelhead { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
+.bf-sectionhead { display: flex; justify-content: space-between; align-items: center; }
+.bf-split2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
+.bf-split2--tight { gap: 8px; }
+.bf-split3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
+.bf-card { background: var(--bf-blue-wash); border: 1px solid var(--bf-border); padding: 10px 12px; display: flex; flex-direction: column; gap: 3px; min-width: 0; }
+.bf-card--green { border-left: 4px solid var(--bf-tertiary); }
+.bf-card--blue { border-left: 4px solid var(--bf-secondary); }
+.bf-card__big { font-family: var(--bf-head); font-size: 24px; font-weight: 900; line-height: 1.15; }
+.bf-card__big small { font-family: var(--bf-mono); font-size: 12px; font-weight: 600; color: var(--bf-neutral); }
+.bf-card__sub { font-size: 11px; color: var(--bf-neutral); }
+.bf-channels { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
+.bf-channel { background: var(--bf-blue-wash); border: 1px solid var(--bf-border); padding: 8px 10px; }
+.bf-channel__head { display: flex; justify-content: space-between; align-items: center; color: var(--bf-secondary); }
+.bf-channel__amt { font-family: var(--bf-head); font-size: 18px; font-weight: 900; margin-top: 4px; }
+
+.bf-bigamount {
+  display: flex; align-items: stretch; background: var(--bf-surface);
+  border: 1px solid var(--bf-border); min-height: 56px;
+}
+.bf-bigamount:focus-within { border-color: var(--bf-secondary); box-shadow: 0 0 0 2px var(--bf-blue-tint); }
+.bf-bigamount.is-error { border-color: var(--bf-danger); }
+.bf-bigamount__sym { width: 56px; display: flex; align-items: center; justify-content: center; background: var(--bf-primary); color: #fff; font-size: 24px; font-weight: 700; flex-shrink: 0; }
+.bf-bigamount__sym--dark { background: #000; }
+.bf-bigamount input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; text-align: right; padding: 0 16px; font-family: var(--bf-head); font-size: 32px; font-weight: 900; color: var(--bf-primary); }
+.bf-statuspill { display: flex; align-items: center; gap: 6px; padding: 0 14px; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; background: var(--bf-blue-wash); color: var(--bf-neutral); }
+.bf-statuspill.is-match { color: var(--bf-success); background: var(--bf-green-tint); }
+.bf-statuspill.is-short { color: var(--bf-danger); background: var(--bf-red-tint); }
+.bf-statuspill.is-surplus { color: var(--bf-amber); background: var(--bf-amber-tint); }
+
+.bf-presets-head { display: flex; justify-content: space-between; align-items: center; margin-top: 4px; }
+.bf-presets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
+.bf-preset { height: 40px; background: var(--bf-blue-tint); border: 1px solid var(--bf-border); font-weight: 700; font-size: 13px; cursor: pointer; color: var(--bf-primary); }
+.bf-preset:hover { background: #bfdbfe; }
+
+.bf-status { font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; color: var(--bf-neutral); }
+.bf-status.is-ok { color: var(--bf-success); }
+.bf-status.is-bad { color: var(--bf-danger); }
+.bf-warnrow { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 6px 10px; background: var(--bf-amber-tint); color: var(--bf-amber); font-size: 11px; font-weight: 600; }
+.bf-warnrow.is-ok { background: var(--bf-green-tint); color: var(--bf-success); }
+.bf-policy { display: flex; gap: 8px; padding: 8px 12px; background: var(--bf-blue-tint); border-left: 3px solid var(--bf-secondary); color: var(--bf-primary); font-size: 11px; line-height: 1.5; }
+.bf-policy p { margin: 0; }
+.bf-policy svg { flex-shrink: 0; margin-top: 2px; color: var(--bf-secondary); }
+
+/* Denominations */
+.bf-den-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
+.bf-den { background: var(--bf-blue-wash); border: 1px solid var(--bf-border); padding: 6px 8px; display: flex; flex-direction: column; gap: 4px; }
+.bf-den--coins { grid-column: span 2; }
+.bf-den__head { display: flex; justify-content: space-between; font-size: 10px; }
+.bf-den__value { font-weight: 700; }
+.bf-den__unit { color: var(--bf-neutral); letter-spacing: 0.05em; }
+.bf-den__stepper { display: flex; height: 30px; background: var(--bf-surface); border: 1px solid var(--bf-border); }
+.bf-den__stepper:focus-within { border-color: var(--bf-secondary); }
+.bf-den__stepper button { width: 28px; border: 0; background: transparent; cursor: pointer; color: var(--bf-primary); display: flex; align-items: center; justify-content: center; }
+.bf-den__stepper button:hover { background: var(--bf-blue-tint); }
+.bf-den__stepper input { flex: 1; min-width: 0; width: 100%; border: 0; outline: 0; text-align: center; font-weight: 700; font-size: 13px; background: transparent; }
+.bf-den__stepper--amount input { text-align: right; padding-right: 8px; }
+.bf-den__rs { width: 26px; display: flex; align-items: center; justify-content: center; color: var(--bf-neutral); }
+.bf-den__sub { font-size: 10px; font-weight: 700; color: var(--bf-success); }
+.bf-assistant { display: flex; flex-direction: column; gap: 8px; padding-top: 8px; border-top: 1px dashed var(--bf-border); }
+
+/* Variance */

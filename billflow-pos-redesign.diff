+        </div>
+      </div>
+
+      <footer className="bf-modal__footer">
+        <button type="button" className="bf-btn bf-btn--ghost" onClick={onClose} disabled={submitting}>
+          CANCEL <Kbd>ESC</Kbd>
+        </button>
+        <span className="bf-spacer" />
+        <button
+          type="button"
+          className="bf-btn bf-btn--green bf-btn--lg"
+          onClick={submit}
+          disabled={submitting}
+        >
+          <FiUnlock /> {submitting ? "STARTING…" : "START SHIFT"} <Kbd>ENTER</Kbd>
+        </button>
+      </footer>
+    </TerminalModal>
+  );
+}
diff -ruN orig/src/components/pos/posTerminal.js /home/claude/app/src/components/pos/posTerminal.js
--- orig/src/components/pos/posTerminal.js	1970-01-01 00:00:00.000000000 +0000
+++ /home/claude/app/src/components/pos/posTerminal.js	2026-11-16 18:19:51.267861608 +0000
@@ -0,0 +1,182 @@
+/* ===== POS TERMINAL — shared primitives for the BillFlow POS design system =====
+ * Used by the B2C billing screen, checkout, start-shift and close-shift modals
+ * so every POS surface shares one visual language and one money format.
+ */
+import React from "react";
+import { FiX, FiMinus, FiPlus } from "react-icons/fi";
+import "../../styles/pos-terminal.css";
+
+/** Amount without currency symbol, Indian grouping: 1,23,456.00 */
+export function money(value) {
+  const n = Number(value);
+  return (Number.isFinite(n) ? n : 0).toLocaleString("en-IN", {
+    minimumFractionDigits: 2,
+    maximumFractionDigits: 2,
+  });
+}
+
+/** ₹ + money(), with a leading minus for negatives: -₹50.00 */
+export function rupees(value) {
+  const n = Number(value) || 0;
+  return `${n < 0 ? "-" : ""}₹${money(Math.abs(n))}`;
+}
+
+/** Currency-safe comparison to the paisa */
+export const sameAmount = (a, b) =>
+  Math.abs((Number(a) || 0) - (Number(b) || 0)) < 0.005;
+
+/** Counted-note denominations used by the cash-count assistants */
+export const NOTE_DENOMINATIONS = [500, 200, 100, 50, 20, 10];
+
+export const emptyCounts = () =>
+  NOTE_DENOMINATIONS.reduce((acc, d) => ({ ...acc, [d]: "" }), {});
+
+/** Sum of notes + loose coin amount. Blank/invalid entries count as 0. */
+export function sumDenominations(counts, coinAmount) {
+  const notes = NOTE_DENOMINATIONS.reduce(
+    (sum, d) => sum + d * (Math.max(0, parseInt(counts[d], 10)) || 0),
+    0,
+  );
+  return notes + (Math.max(0, parseFloat(coinAmount)) || 0);
+}
+
+/**
+ * Modal frame shared by every POS dialog: overlay, fixed header height,
+ * scrolling body, pinned footer. `tone` colours the header
+ * (navy | blue | green | red).
+ */
+export function TerminalModal({
+  tone = "navy",
+  label,
+  ariaLabel,
+  children,
+  onOverlayClick,
+  onKeyDown,
+  width = 760,
+}) {
+  return (
+    <div
+      className="bf-overlay"
+      onMouseDown={(e) => {
+        if (e.target === e.currentTarget) onOverlayClick?.();
+      }}
+      onKeyDown={onKeyDown}
+    >
+      <div
+        className={`bf-modal bf-modal--${tone}`}
+        role="dialog"
+        aria-modal="true"
+        aria-label={ariaLabel || label}
+        style={{ "--bf-modal-w": `${width}px` }}
+      >
+        {children}
+      </div>
+    </div>
+  );
+}
+
+export function ModalClose({ onClick, disabled }) {
+  return (
+    <button
+      type="button"
+      className="bf-modal__close"
+      onClick={onClick}
+      disabled={disabled}
+      aria-label="Close"
+    >
+      <FiX />
+    </button>
+  );
+}
+
+/** [KEY] hint chip used on buttons */
+export function Kbd({ children }) {
+  return <span className="bf-kbd">{children}</span>;
+}
+
+/**
+ * Denomination counter grid. Counts are held by the parent so the sheet can be
+ * compared against whatever amount the existing workflow collects.
+ */
+export function DenominationGrid({
+  counts,
+  onCountChange,
+  coinAmount,
+  onCoinChange,
+  coinLabel = "Coins / Loose Misc",
+  idPrefix = "den",
+}) {
+  const step = (d, delta) => {
+    const next = Math.max(0, (parseInt(counts[d], 10) || 0) + delta);
+    onCountChange(d, next === 0 ? "" : String(next));
+  };
+
+  return (
+    <div className="bf-den-grid">
+      {NOTE_DENOMINATIONS.map((d) => {
+        const qty = Math.max(0, parseInt(counts[d], 10)) || 0;
+        return (
+          <div className="bf-den" key={d}>
+            <div className="bf-den__head">
+              <span className="bf-den__value">₹{d}</span>
+              <span className="bf-den__unit">NOTES</span>
+            </div>
+            <div className="bf-den__stepper">
+              <button
+                type="button"
+                tabIndex={-1}
+                aria-label={`Decrease ₹${d} notes`}
+                onClick={() => step(d, -1)}
+              >
+                <FiMinus />
+              </button>
+              <input
+                id={`${idPrefix}-${d}`}
+                inputMode="numeric"
+                aria-label={`Number of ₹${d} notes`}
+                value={counts[d]}
+                placeholder="0"
+                onChange={(e) => {
+                  const v = e.target.value;
+                  if (v === "" || /^\d{1,5}$/.test(v)) onCountChange(d, v);
+                }}
+                onFocus={(e) => e.target.select()}
+              />
+              <button
+                type="button"
+                tabIndex={-1}
+                aria-label={`Increase ₹${d} notes`}
+                onClick={() => step(d, 1)}
+              >
+                <FiPlus />
+              </button>
+            </div>
+            <div className="bf-den__sub">= ₹{money(qty * d)}</div>
+          </div>
+        );
+      })}
+      <div className="bf-den bf-den--coins">
+        <div className="bf-den__head">
+          <span className="bf-den__value">{coinLabel}</span>
+          <span className="bf-den__unit">AMOUNT</span>
+        </div>
+        <div className="bf-den__stepper bf-den__stepper--amount">
+          <span className="bf-den__rs">₹</span>
+          <input
+            id={`${idPrefix}-coins`}
+            inputMode="decimal"
+            aria-label="Coins and loose amount"
+            value={coinAmount}
+            placeholder="0"
+            onChange={(e) => {
+              const v = e.target.value;
+              if (v === "" || /^\d{0,6}(\.\d{0,2})?$/.test(v)) onCoinChange(v);
+            }}
+            onFocus={(e) => e.target.select()}
+          />
+        </div>
+        <div className="bf-den__sub">= ₹{money(parseFloat(coinAmount) || 0)}</div>
+      </div>
+    </div>
+  );
+}

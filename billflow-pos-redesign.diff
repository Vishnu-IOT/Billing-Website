+
+  useEffect(() => {
+    if (!open) return undefined;
+    setCounts(emptyCounts());
+    setCoins("");
+    setTouched(false);
+    const t = setInterval(() => setNow(new Date()), 1000);
+    return () => clearInterval(t);
+  }, [open]);
+
+  const counted = useMemo(() => sumDenominations(counts, coins), [counts, coins]);
+  const hasCount = counted > 0;
+  const entered = parseFloat(floatValue);
+  const floatMissing = floatValue === "" || !Number.isFinite(entered) || entered < 0;
+  const matched = hasCount && !floatMissing && sameAmount(counted, entered);
+  const diff = hasCount && !floatMissing ? counted - entered : 0;
+
+  if (!open) return null;
+
+  const submit = () => {
+    setTouched(true);
+    if (floatMissing || submitting) return;
+    onStart();

+            onCoinChange={setCoins}
+          />
+          {hasCount && !floatMissing && !matched && (
+            <div className="bf-warnrow" role="status">
+              <FiAlertTriangle /> Counted cash differs from the opening float by{" "}
+              <strong>{rupees(diff)}</strong>.
+              <button
+                type="button"
+                className="bf-link"
+                onClick={() => onFloatChange(String(Number(counted.toFixed(2))))}
+              >
+                USE COUNTED AMOUNT AS FLOAT
+              </button>
+            </div>
+          )}
+          {hasCount && floatMissing && (
+            <div className="bf-warnrow">
+              <button
+                type="button"
+                className="bf-link"
+                onClick={() => onFloatChange(String(Number(counted.toFixed(2))))}
